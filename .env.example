# ==============================================================================
# YASNA CONTENT PIPELINE — CONFIGURATION EXAMPLE
# ==============================================================================

# NVIDIA NIM API (OpenAI-compatible chat completions)
NIM_API_KEY=
NIM_MODEL=meta/llama-3.3-70b-instruct
NIM_BASE_URL=https://integrate.api.nvidia.com/v1

# Pexels Video Search API
PEXELS_API_KEY=

# Amazon Associates
AMAZON_ASSOCIATE_ID=

# Additional AI providers
GEMINI_API_KEY=
GROQ_API_KEY=

# YouTube Data API v3
YT_CLIENT_SECRET_PATH=client_secret.json
YT_TOKEN_PATH=token.json

# Instagram Graph API
IG_ACCESS_TOKEN=
IG_USER_ID=
IG_TOKEN_ISSUED_DATE=
WEBHOOK_VERIFY_TOKEN=
PUBLIC_HOST_ENDPOINT=https://your-ngrok-or-server-url.ngrok-free.dev

# Telegram Bot API Credentials & Auto-Publish Control
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
AUTO_PUBLISH_ENABLED=false

# Whisper model for captioning (options: tiny, base, small, medium, large)
WHISPER_MODEL=base

# Video Properties
VIDEO_WIDTH=1080
VIDEO_HEIGHT=1920
TARGET_VOICEOVER_DURATION=27.5

# Subtitle / Caption Styles
CAPTION_FONT=Arial
CAPTION_FONT_SIZE=34
CAPTION_PRIMARY_COLOR=&H00ffffff
CAPTION_OUTLINE_COLOR=&H00000000
CAPTION_OUTLINE_WIDTH=3
CAPTION_SHADOW=1
CAPTION_ALIGNMENT=5
CAPTION_MARGIN_V=0

# Linktree / Affiliate Store Bio Link
LINKTREE_URL=https://linktr.ee/yasna_store0808
