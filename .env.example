# ==============================================================================
# YASNA CONTENT PIPELINE - CONFIGURATION TEMPLATE
# ==============================================================================

# NVIDIA NIM API Configs (OpenAI-compatible)
# Generate your key on build.nvidia.com
NIM_API_KEY=your_nvidia_nim_api_key_here
NIM_MODEL=meta/llama-3.3-70b-instruct
NIM_BASE_URL=https://integrate.api.nvidia.com/v1

# Pexels Video Search API Configs
# Obtain from pexels.com/api/new/
PEXELS_API_KEY=your_pexels_api_key_here

# YouTube Data API v3 Configs
# Path to your OAuth client secret JSON downloaded from Google Cloud Console
YT_CLIENT_SECRET_PATH=client_secret.json
# Path to save/load persistent credentials (refreshed automatically)
YT_TOKEN_PATH=token.json

# Instagram Graph API Configs (Meta Developer Portal)
# Short/Long-lived User Access Token with instagram_basic & instagram_content_publish permissions
IG_ACCESS_TOKEN=your_instagram_graph_access_token_here
# Professional Instagram Account ID linked to your Facebook page
IG_USER_ID=your_instagram_user_id_here
# Date token was issued (to track long-lived token 60-day expiration)
IG_TOKEN_ISSUED_DATE=2026-07-03
# Public HTTP endpoint (e.g. ngrok tunnel) hosting temporary video assets for IG's container upload step
PUBLIC_HOST_ENDPOINT=https://your-public-endpoint.ngrok-free.app

# Video Properties
VIDEO_WIDTH=1080
VIDEO_HEIGHT=1920
# Ideal time limit in seconds (under 60s for Shorts/Reels, target 25-30s)
TARGET_VOICEOVER_DURATION=27.5

# Subtitle Styles (Advanced Substation Alpha format)
# Font family name (must be installed on rendering machine, e.g. Arial, Outfit, Inter)
CAPTION_FONT=Arial
# Font size for 1080x1920 canvas
CAPTION_FONT_SIZE=54
# Hex primary color in BGR format: &H00BBGGRR (&H00ffffff is White, &H0000ffff is Yellow)
CAPTION_PRIMARY_COLOR=&H00ffffff
# Hex outline stroke color in BGR format (&H00000000 is Black)
CAPTION_OUTLINE_COLOR=&H00000000
# Outline stroke border width
CAPTION_OUTLINE_WIDTH=4
# Shadow depth offset
CAPTION_SHADOW=1
# Screen alignment (2 = Bottom Center, 5 = Absolute Center, 8 = Top Center)
CAPTION_ALIGNMENT=2
# Vertical margin offset from the bottom of the video frame
CAPTION_MARGIN_V=250
